include_guard(GLOBAL)

function(woby_collect_system_targets directory result)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        woby_collect_system_targets("${child}" child_targets)
        list(APPEND targets ${child_targets})
    endforeach()
    set("${result}" "${targets}" PARENT_SCOPE)
endfunction()

# This runs after the project targets have been declared. System ownership is
# independent of link targets; every checked source gets its own module name.
function(woby_configure_system_checks)
    include("${PROJECT_SOURCE_DIR}/cmake/WobyPython.cmake")
    set(checker "${PROJECT_SOURCE_DIR}/tools/check_systems.py")
    set(output "${PROJECT_BINARY_DIR}/systems")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/systems.toml" "${checker}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${checker}" generate
        --root "${PROJECT_SOURCE_DIR}" --build "${PROJECT_BINARY_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output_text ERROR_VARIABLE error_text)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot configure system boundaries:\n${output_text}${error_text}")
    endif()
    file(READ "${output}/inventory.json" inventory)
    # Watch the manifest's roots. A new or removed source changes the map;
    # editing a source or writing Python bytecode does not reconfigure CMake.
    string(JSON root_count LENGTH "${inventory}" roots)
    math(EXPR last_root "${root_count} - 1")
    set(patterns)
    foreach(index RANGE ${last_root})
        string(JSON root GET "${inventory}" roots ${index})
        foreach(extension IN ITEMS h hpp hh hxx inl inc cpp cc cxx mm cppm)
            list(APPEND patterns "${root}/*.${extension}")
        endforeach()
    endforeach()
    file(GLOB_RECURSE system_files CONFIGURE_DEPENDS ${patterns})
    string(JSON source_count LENGTH "${inventory}" sources)
    set(checked_sources)
    if(source_count GREATER 0)
        math(EXPR last_source "${source_count} - 1")
        foreach(index RANGE ${last_source})
            string(JSON source MEMBER "${inventory}" sources ${index})
            list(APPEND checked_sources "${source}")
        endforeach()
    endif()

    if(CMAKE_CONFIGURATION_TYPES)
        set(configurations ${CMAKE_CONFIGURATION_TYPES})
    else()
        set(configurations "${CMAKE_BUILD_TYPE}")
    endif()
    woby_collect_system_targets("${PROJECT_SOURCE_DIR}" targets)
    set(checked_targets)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        get_target_property(excluded "${target}" EXCLUDE_FROM_ALL)
        if(excluded OR NOT type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            continue()
        endif()
        get_target_property(sources "${target}" SOURCES)
        get_target_property(module_sets "${target}" CXX_MODULE_SETS)
        foreach(module_set IN LISTS module_sets)
            get_target_property(module_sources "${target}" "CXX_MODULE_SET_${module_set}")
            list(APPEND sources ${module_sources})
        endforeach()
        get_target_property(source_directory "${target}" SOURCE_DIR)
        set(target_sources)
        foreach(source IN LISTS sources)
            if(source MATCHES "\\$<")
                continue()
            endif()
            cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${source_directory}" NORMALIZE)
            if(source IN_LIST checked_sources)
                list(APPEND target_sources "${source}")
                string(JSON owner GET "${inventory}" sources "${source}")
                if(MSVC)
                    set(option "/clang:-fmodule-name=${owner}")
                else()
                    set(option "-fmodule-name=${owner}")
                endif()
                get_property(source_options SOURCE "${source}" TARGET_DIRECTORY "${target}" PROPERTY COMPILE_OPTIONS)
                if(NOT option IN_LIST source_options)
                    set_property(SOURCE "${source}" TARGET_DIRECTORY "${target}" APPEND PROPERTY COMPILE_OPTIONS "${option}")
                    set_property(SOURCE "${source}" TARGET_DIRECTORY "${target}" APPEND PROPERTY OBJECT_DEPENDS "${output}/systems.modulemap")
                endif()
            endif()
        endforeach()
        if(NOT target_sources)
            continue()
        endif()
        list(REMOVE_DUPLICATES target_sources)
        list(APPEND checked_targets "${target}")
        foreach(config IN LISTS configurations)
            file(MAKE_DIRECTORY "${output}/${config}/commands/${target}")
        endforeach()
        set(fragment_directory "${output}/$<CONFIG>/commands/${target}")
        # Clang gives each compilation a unique fragment. The CLI selects the
        # newest command for each configured target/source pair.
        if(MSVC)
            set(options "/clang:-gen-cdb-fragment-path" "/clang:${fragment_directory}")
        else()
            set(options "-gen-cdb-fragment-path" "${fragment_directory}")
        endif()
        target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:${options}>")
        string(JOIN "\n" source_text ${target_sources})
        file(GENERATE OUTPUT "${output}/$<CONFIG>/sources-${target}.txt" CONTENT "${source_text}\n")
    endforeach()
    string(JOIN "\n" target_text ${checked_targets})
    file(GENERATE OUTPUT "${output}/$<CONFIG>/targets.txt" CONTENT "${target_text}\n")

    set(command "${Python3_EXECUTABLE}" "${checker}" check
        --root "${PROJECT_SOURCE_DIR}" --build "${PROJECT_BINARY_DIR}"
        --config "$<CONFIG>" --llvm-root "${WOBY_LLVM_ROOT}")
    add_custom_target(woby_check_systems ALL COMMAND ${command}
        DEPENDS ${checked_targets} VERBATIM USES_TERMINAL)
    if(BUILD_TESTING)
        add_test(NAME woby_module_checker COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/module_checker_tests.py")
        set_tests_properties(woby_module_checker PROPERTIES LABELS "unit;cpu")
        add_test(NAME woby_system_boundaries COMMAND ${command})
        set_tests_properties(woby_system_boundaries PROPERTIES LABELS "unit;cpu" TIMEOUT 1800)
        add_test(NAME woby_system_checker COMMAND "${Python3_EXECUTABLE}"
            "${PROJECT_SOURCE_DIR}/tests/system_checker_tests.py" --llvm-root "${WOBY_LLVM_ROOT}")
        set_tests_properties(woby_system_checker PROPERTIES LABELS "unit;cpu" TIMEOUT 180)
    endif()
endfunction()
