# This file is shared by Woby and vcpkg dependency builds.
include_guard(GLOBAL)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../llvm-toolchain.json" woby_llvm_manifest)
string(JSON WOBY_LLVM_VERSION GET "${woby_llvm_manifest}" version)

if(NOT WOBY_LLVM_ROOT)
    if(DEFINED ENV{WOBY_LLVM_ROOT} AND NOT "$ENV{WOBY_LLVM_ROOT}" STREQUAL "")
        set(WOBY_LLVM_ROOT "$ENV{WOBY_LLVM_ROOT}")
    elseif(CMAKE_HOST_WIN32)
        set(WOBY_LLVM_ROOT "$ENV{ProgramFiles}/LLVM")
    else()
        find_program(woby_clang NAMES clang REQUIRED)
        get_filename_component(woby_llvm_bin "${woby_clang}" DIRECTORY)
        get_filename_component(WOBY_LLVM_ROOT "${woby_llvm_bin}" DIRECTORY)
    endif()
endif()
file(TO_CMAKE_PATH "${WOBY_LLVM_ROOT}" WOBY_LLVM_ROOT)
set(WOBY_LLVM_ROOT "${WOBY_LLVM_ROOT}" CACHE PATH "Pinned LLVM installation")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES WOBY_LLVM_ROOT)

if(CMAKE_HOST_WIN32)
    set(woby_c "${WOBY_LLVM_ROOT}/bin/clang-cl.exe")
    set(woby_cxx "${woby_c}")
else()
    set(woby_c "${WOBY_LLVM_ROOT}/bin/clang")
    set(woby_cxx "${WOBY_LLVM_ROOT}/bin/clang++")
endif()
execute_process(COMMAND "${woby_cxx}" --version
    RESULT_VARIABLE woby_compiler_result OUTPUT_VARIABLE woby_compiler_version ERROR_VARIABLE woby_compiler_error)
string(REGEX MATCH "^clang version ([0-9]+\\.[0-9]+\\.[0-9]+)([ \r\n]|$)" woby_compiler_match "${woby_compiler_version}")
if(NOT woby_compiler_result STREQUAL "0" OR NOT CMAKE_MATCH_1 VERSION_EQUAL WOBY_LLVM_VERSION)
    message(FATAL_ERROR "Woby requires upstream Clang ${WOBY_LLVM_VERSION}. Set WOBY_LLVM_ROOT to that installation.\n${woby_compiler_version}${woby_compiler_error}")
endif()

if(CMAKE_GENERATOR MATCHES "^Visual Studio")
    if(NOT CMAKE_GENERATOR_TOOLSET MATCHES "^ClangCL(,|$)")
        message(FATAL_ERROR "Use the ClangCL toolset with the Visual Studio generator.")
    endif()
    list(APPEND CMAKE_VS_GLOBALS "LLVMInstallDir=${WOBY_LLVM_ROOT}" "LLVMToolsVersion=${WOBY_LLVM_VERSION}")
else()
    set(CMAKE_C_COMPILER "${woby_c}")
    set(CMAKE_CXX_COMPILER "${woby_cxx}")
endif()
if(CMAKE_HOST_APPLE)
    set(CMAKE_OBJC_COMPILER "${woby_c}")
    set(CMAKE_OBJCXX_COMPILER "${woby_cxx}")
endif()

# Preserve vcpkg's architecture, runtime linkage, and port flags. These values
# are supplied for dependency builds, but not for the application build.
if(DEFINED VCPKG_CRT_LINKAGE AND DEFINED _VCPKG_ROOT_DIR)
    if(CMAKE_HOST_WIN32)
        # The vcpkg Windows toolchain checks this path before adding /MP.
        set(CMAKE_C_COMPILER "${woby_c}")
        set(CMAKE_CXX_COMPILER "${woby_cxx}")
        include("${_VCPKG_ROOT_DIR}/scripts/toolchains/windows.cmake")
        string(REPLACE "/RTC1" "" CMAKE_C_FLAGS_DEBUG "${CMAKE_C_FLAGS_DEBUG}")
        string(REPLACE "/RTC1" "" CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG}")
    elseif(CMAKE_HOST_APPLE)
        include("${_VCPKG_ROOT_DIR}/scripts/toolchains/osx.cmake")
    else()
        include("${_VCPKG_ROOT_DIR}/scripts/toolchains/linux.cmake")
    endif()
endif()
