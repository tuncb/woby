include_guard(GLOBAL)

# Use the target platform, not the host, for cross-compilation.
set(woby_target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_GENERATOR_PLATFORM)
    set(woby_target_cpu "${CMAKE_GENERATOR_PLATFORM}")
endif()
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(woby_target_cpu "${CMAKE_OSX_ARCHITECTURES}")
endif()

function(woby_enable_cpu_baseline target)
    # Research targets can retain their explicitly named compiler baseline.
    set(enabled "$<NOT:$<BOOL:$<TARGET_PROPERTY:WOBY_LEGACY_ISA>>>")
    if(woby_target_cpu MATCHES "^(AMD64|amd64|x86_64|x64)$")
        if(MSVC)
            target_compile_options(${target} PRIVATE "$<$<AND:$<COMPILE_LANGUAGE:CXX>,${enabled}>:/arch:AVX2>")
        else()
            target_compile_options(${target} PRIVATE "$<$<AND:$<COMPILE_LANGUAGE:CXX>,${enabled}>:-mavx2;-ffp-contract=off>")
        endif()
    elseif(APPLE AND woby_target_cpu MATCHES "^(arm64|aarch64)$")
        target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX,OBJCXX>:-mcpu=apple-m1;-ffp-contract=off>")
    endif()
endfunction()

option(WOBY_ENABLE_AVX512_REBASE "Build the experimental, CPU-dispatched AVX-512 coordinate rebase path" OFF)

function(woby_configure_avx512_rebase)
    if(NOT WOBY_ENABLE_AVX512_REBASE)
        return()
    endif()
    if(NOT woby_target_cpu MATCHES "^(AMD64|amd64|x86_64|x64)$")
        message(FATAL_ERROR "WOBY_ENABLE_AVX512_REBASE requires an x64 target")
    endif()
    add_library(woby_coordinate_avx512 STATIC "${PROJECT_SOURCE_DIR}/src/coordinate_simd_avx512.cpp")
    set_target_properties(woby_coordinate_avx512 PROPERTIES WOBY_LEGACY_ISA ON INTERPROCEDURAL_OPTIMIZATION OFF)
    woby_enable_project_warnings(woby_coordinate_avx512)
    if(MSVC)
        target_compile_options(woby_coordinate_avx512 PRIVATE /arch:AVX512)
    else()
        target_compile_options(woby_coordinate_avx512 PRIVATE -mavx512f -mavx512dq -mavx512cd -mavx512bw -mavx512vl -ffp-contract=off)
    endif()
    target_link_libraries(woby_core PUBLIC woby_coordinate_avx512)
    target_compile_definitions(woby_core PUBLIC WOBY_ENABLE_AVX512_REBASE)
endfunction()
