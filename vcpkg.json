{
  "name": "woby-obj-viewer",
  "version-string": "0.21.1",
  "dependencies": [
    "sdl3",
    {
      "name": "bgfx",
      "features": [
        "tools"
      ]
    },
    "meshoptimizer",
    {
      "name": "imgui",
      "features": [
        "sdl3-binding",
        "wchar32"
      ]
    },
    "spdlog",
    { "name": "cpp-httplib", "default-features": false },
    "nlohmann-json",
    { "name": "curl", "default-features": false, "features": ["ssl"] },
    { "name": "libarchive", "default-features": false },
    { "name": "openssl", "platform": "!windows" },
    "boost-multiprecision",
    "boost-unordered",
    "doctest"
  ],
  "features": {
    "hash-benchmarks": {
      "description": "Compare standard, Woby, Boost and unordered_dense hash tables",
      "dependencies": ["unordered-dense"]
    }
  }
}
