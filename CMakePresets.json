{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 5,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-vcpkg",
      "displayName": "Visual Studio 2026 + Clang + vcpkg manifest",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.vcpkg"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "ClangCL,host=x64",
      "binaryDir": "${sourceDir}/build/${presetName}-clang",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm.cmake",
        "VCPKG_TARGET_TRIPLET": "woby-x64-windows",
        "VCPKG_HOST_TRIPLET": "woby-x64-windows",
        "CMAKE_VS_GLOBALS": "UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true"
      }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 + Clang with installed packages",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "ClangCL,host=x64",
      "binaryDir": "${sourceDir}/build/${presetName}-clang",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm.cmake",
        "CMAKE_VS_GLOBALS": "UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true"
      }
    },
    {
      "name": "ninja-vcpkg",
      "displayName": "Ninja + Clang + vcpkg manifest",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.vcpkg"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm.cmake"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja + Clang with installed packages",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}-clang",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "module-trial-vcpkg",
      "displayName": "Module trial: Ninja Multi-Config + Clang + vcpkg",
      "inherits": "ninja-vcpkg",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/module-trial-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": null,
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-vcpkg",
      "configurePreset": "vs2026-vcpkg",
      "jobs": 2,
      "configuration": "Debug"
    },
    {
      "name": "vs2026",
      "configurePreset": "vs2026",
      "jobs": 2,
      "configuration": "Debug"
    },
    {
      "name": "ninja-vcpkg",
      "configurePreset": "ninja-vcpkg"
    },
    {
      "name": "ninja",
      "configurePreset": "ninja"
    },
    {
      "name": "module-trial-vcpkg",
      "configurePreset": "module-trial-vcpkg",
      "configuration": "Release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-vcpkg",
      "configurePreset": "vs2026-vcpkg",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "label": "^(slow|graphics)$"
        }
      }
    },
    {
      "name": "ninja-vcpkg",
      "configurePreset": "ninja-vcpkg",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "label": "^(slow|graphics)$"
        }
      }
    },
    {
      "name": "vs2026-vcpkg-slow",
      "inherits": "vs2026-vcpkg",
      "filter": {
        "include": {
          "label": "^slow$"
        },
        "exclude": {
          "label": "^$"
        }
      }
    },
    {
      "name": "vs2026-vcpkg-graphics",
      "inherits": "vs2026-vcpkg",
      "filter": {
        "include": {
          "label": "^graphics$"
        },
        "exclude": {
          "label": "^slow$"
        }
      }
    },
    {
      "name": "ninja-vcpkg-slow",
      "inherits": "ninja-vcpkg",
      "filter": {
        "include": {
          "label": "^slow$"
        },
        "exclude": {
          "label": "^$"
        }
      }
    },
    {
      "name": "ninja-vcpkg-graphics",
      "inherits": "ninja-vcpkg",
      "filter": {
        "include": {
          "label": "^graphics$"
        },
        "exclude": {
          "label": "^slow$"
        }
      }
    },
    {
      "name": "module-trial-vcpkg",
      "configurePreset": "module-trial-vcpkg",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      },
      "filter": {
        "exclude": {
          "label": "^(slow|graphics)$"
        }
      }
    }
  ]
}
