cmake_minimum_required(VERSION 3.24)

include("${PROPERTY_FILE}")

if(NOT core_type STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "Shared production code must not require an extra runtime DLL")
endif()
foreach(consumer IN ITEMS app test)
    if(NOT "woby_core" IN_LIST ${consumer}_links)
        message(FATAL_ERROR "The ${consumer} executable does not link the production library")
    endif()
endforeach()
foreach(definition IN LISTS core_definitions)
    if(definition MATCHES "^WOBY_(VERSION|BUILD_CONFIG|TEST_)")
        message(FATAL_ERROR "Executable-specific definition leaked into the production library: ${definition}")
    endif()
endforeach()

# Use absolute paths so alternate spellings cannot hide a duplicate source.
foreach(target IN ITEMS core app test)
    set(${target}_cpp)
    foreach(source IN LISTS ${target}_sources)
        if(source MATCHES "\\.cpp$")
            cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${source_root}" NORMALIZE)
            list(APPEND ${target}_cpp "${source}")
        endif()
    endforeach()
endforeach()
if(NOT core_cpp)
    message(FATAL_ERROR "The production library has no C++ sources")
endif()
foreach(source IN LISTS core_cpp)
    if(source IN_LIST app_cpp OR source IN_LIST test_cpp)
        message(FATAL_ERROR "A production source is compiled again by an executable: ${source}")
    endif()
endforeach()
foreach(source IN LISTS app_cpp)
    if(source IN_LIST test_cpp)
        message(FATAL_ERROR "A source is still compiled separately by the app and tests: ${source}")
    endif()
endforeach()

message(STATUS "App and tests reuse one production library without duplicate sources")
