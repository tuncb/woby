{
  "format": "mesh-memory-lab.workflow",
  "version": 1,
  "title": "Shared quad",
  "description": "Two triangles share four vertices: generated normals, missing UVs, and index reuse.",
  "source": {
    "format": "obj",
    "text": "# Two triangles sharing an edge; no authored normals or UVs.\nv -1 -1 0\nv 1 -1 0\nv 1 1 0\nv -1 1 0\nf 1 2 3\nf 1 3 4\n"
  },
  "initial_node": "pack",
  "nodes": [
    {
      "id": "source",
      "title": "OBJ text",
      "kind": "data",
      "summary": "Embedded source text",
      "description": "Four positions and two triangles, with no authored normal or UV records. Compare the packing and memory payloads with the folded-sheet workflow.",
      "position": [
        0,
        0
      ],
      "inspector": "source"
    },
    {
      "id": "parse",
      "title": "Parse",
      "kind": "transform",
      "summary": "Text to typed values",
      "description": "Parse decimal positions as doubles and normals and UVs as floats. Resolve OBJ indices into independent zero-based domains.",
      "position": [
        238,
        0
      ],
      "inspector": "parse"
    },
    {
      "id": "attributes",
      "title": "Attribute pools",
      "kind": "data",
      "summary": "Independent index domains",
      "description": "Polygon corners refer independently to the position, normal, and UV pools. A shared position can have multiple normal and UV identities.",
      "position": [
        476,
        0
      ],
      "inspector": "attributes"
    },
    {
      "id": "triangulate",
      "title": "Rebase + split",
      "kind": "transform",
      "summary": "Localize and triangulate",
      "description": "Subtract the coordinate origin in double precision, then triangulate each polygon without losing its corner attributes.",
      "position": [
        714,
        0
      ],
      "inspector": "triangulate"
    },
    {
      "id": "corners",
      "title": "Corner stream",
      "kind": "data",
      "summary": "Triangle corner tuples",
      "description": "Each consecutive group of three corner tuples describes one triangle. The tuples still refer to independent source attribute pools.",
      "position": [
        952,
        0
      ],
      "inspector": "corners"
    },
    {
      "id": "pack",
      "title": "Intern + pack",
      "kind": "transform",
      "summary": "Reuse or create vertices",
      "description": "The shared position tuples reuse their render vertices. Missing normals are generated by the production loader; missing UVs use the loader's fallback values.",
      "position": [
        714,
        166
      ],
      "inspector": "pack"
    },
    {
      "id": "mesh",
      "title": "CPU mesh",
      "kind": "data",
      "summary": "Packed and precise arrays",
      "description": "Retain packed vertices, render indices, precise positions, original source points, and source indices. Only the packed vertices and render indices are uploaded.",
      "position": [
        476,
        166
      ],
      "inspector": "mesh"
    },
    {
      "id": "upload",
      "title": "Copy to GPU",
      "kind": "transform",
      "summary": "Copy, submit, retain",
      "description": "Allocate GPU buffers using owned byte copies. Retain the CPU capture, and keep readback destinations alive until completion.",
      "position": [
        238,
        166
      ],
      "inspector": "upload"
    },
    {
      "id": "gpu",
      "title": "GPU buffers",
      "kind": "data",
      "summary": "Indexed vertex fetch",
      "description": "The production shaders fetch 32-byte vertex records through the index stream. Readback verifies the uploaded buffers byte for byte.",
      "position": [
        0,
        166
      ],
      "inspector": "gpu"
    }
  ],
  "edges": [
    {
      "from": "source",
      "to": "parse"
    },
    {
      "from": "parse",
      "to": "attributes"
    },
    {
      "from": "attributes",
      "to": "triangulate"
    },
    {
      "from": "triangulate",
      "to": "corners"
    },
    {
      "from": "corners",
      "to": "pack"
    },
    {
      "from": "pack",
      "to": "mesh"
    },
    {
      "from": "mesh",
      "to": "upload"
    },
    {
      "from": "upload",
      "to": "gpu"
    }
  ]
}
