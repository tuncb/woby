{
  "format": "mesh-memory-lab.workflow",
  "version": 1,
  "title": "73. Bounded and canceled overlap work",
  "description": "Catalog workflow 73. Candidate enumeration → cancellation checkpoints and candidate/pair limits → complete or explicitly truncated result → UI/report status. Inspect the 2,000,000-candidate and 10,000-pair limits and avoid interpreting partial results as proof of no overlaps.\n\nDescriptive diagram: stages and values are explained in the inspector; this file does not execute the workflow or capture historical results.\n\nImplementation: src/uv_quality.h:UvOverlapLimits; src/uv_overlap.cpp:inspectUvOverlaps; src/comparison_report.cpp.",
  "initial_node": "candidate",
  "nodes": [
    {
      "id": "work",
      "title": "Overlap request",
      "kind": "data",
      "summary": "Enabled state and configured limits",
      "description": "Default limits are 2,000,000 broad-phase candidates and 10,000 retained overlap pairs. Disabled analysis stays unchecked.",
      "position": [
        0,
        0
      ]
    },
    {
      "id": "cancel",
      "title": "Cancellation check",
      "kind": "transform",
      "summary": "At setup, loops, and completion",
      "description": "Check the stop token during box construction and candidate enumeration, and again before accepting the result.",
      "position": [
        310,
        0
      ]
    },
    {
      "id": "candidate",
      "title": "Candidate budget?",
      "kind": "transform",
      "summary": "Count before V rejection",
      "description": "Before testing another broad-phase candidate, compare overlapCandidates to the candidate limit; long strips can exhaust this budget with few actual overlaps.",
      "position": [
        620,
        0
      ]
    },
    {
      "id": "pair",
      "title": "Positive-area pair?",
      "kind": "transform",
      "summary": "Narrow phase and pair budget",
      "description": "Reject V-separated or non-overlapping pairs. Before recording another actual overlap, enforce the retained-pair limit.",
      "position": [
        620,
        190
      ]
    },
    {
      "id": "complete",
      "title": "Completed scan",
      "kind": "data",
      "summary": "Checked, not truncated",
      "description": "All eligible candidates were processed. Zero findings only carries this completion meaning within the configured domain.",
      "position": [
        930,
        190
      ]
    },
    {
      "id": "truncated",
      "title": "Bounded partial result",
      "kind": "data",
      "summary": "Checked and truncated",
      "description": "Retain recorded pairs and counts, but explicitly mark truncation when further work hits a limit.",
      "position": [
        930,
        0
      ]
    },
    {
      "id": "canceled",
      "title": "Canceled result",
      "kind": "data",
      "summary": "Discard partial work",
      "description": "Cancellation throws out of worker preparation and never publishes its partial quality result.",
      "position": [
        310,
        190
      ]
    },
    {
      "id": "report",
      "title": "UI and report status",
      "kind": "data",
      "summary": "Unchecked / complete / truncated",
      "description": "Always present completion state with the pair list. A truncated zero-pair result is not proof that no overlaps exist.",
      "position": [
        1240,
        0
      ]
    }
  ],
  "edges": [
    {
      "from": "work",
      "to": "cancel"
    },
    {
      "from": "cancel",
      "to": "canceled",
      "label": "stop"
    },
    {
      "from": "cancel",
      "to": "candidate",
      "label": "active"
    },
    {
      "from": "candidate",
      "to": "truncated",
      "label": "limit"
    },
    {
      "from": "candidate",
      "to": "pair",
      "label": "budget"
    },
    {
      "from": "pair",
      "to": "truncated",
      "label": "pair limit"
    },
    {
      "from": "pair",
      "to": "cancel",
      "label": "next"
    },
    {
      "from": "pair",
      "to": "complete",
      "label": "exhausted"
    },
    {
      "from": "complete",
      "to": "report"
    },
    {
      "from": "truncated",
      "to": "report"
    }
  ]
}
