      "position": [
        930,
        190
      ]
    },
    {
      "id": "geometry",
      "title": "Evaluated geometry",
      "kind": "data",
      "summary": "Sampled positions and derivatives",
      "description": "Use the evaluated curve or surface data for tessellation. Compare rational and unit-weight cases with the same knots.",
      "position": [
        620,
        190
      ]
    }
