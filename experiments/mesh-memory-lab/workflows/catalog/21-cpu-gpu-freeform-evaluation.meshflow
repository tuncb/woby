{
  "format": "mesh-memory-lab.workflow",
  "version": 1,
  "title": "21. Fixed freeform evaluation",
  "description": "Catalog workflow 21. Native controls and a fixed parameter grid produce one CPU geometry result. Rendering uploads that result.\n\nDescriptive diagram: stages and values are explained in the inspector; this file does not execute the workflow or capture historical results.\n\nImplementation: src/freeform.cpp; src/freeform_trim.cpp; src/scene_renderer.cpp.",
  "initial_node": "cpu",
  "nodes": [
    {
      "id": "inputs",
      "title": "Native freeform input",
      "kind": "data",
      "summary": "Controls, knots, and trim loops",
      "description": "Retain immutable source data and deterministic parameter samples.",
      "position": [
        0,
        0
      ]
    },
    {
      "id": "cpu",
      "title": "CPU evaluation",
      "kind": "transform",
      "summary": "One sample supplies position and normal",
      "description": "Evaluate the fixed samples in double precision. Reuse their derivatives and authored normals. Singular normals can require an interior sample. CPU trim triangulation supplies connectivity.",
      "position": [
        310,
        0
      ]
    },
    {
      "id": "cache",
      "title": "Completed CPU geometry",
      "kind": "data",
      "summary": "Vertices, connectivity, and provenance",
      "description": "Bounds, picking, annotations, and analysis use this geometry. Native controls and parameter samples remain available.",
      "position": [
        620,
        0
      ]
    },
    {
      "id": "draw",
      "title": "Upload and draw",
      "kind": "transform",
      "summary": "Render the completed geometry",
      "description": "Upload the CPU vertices and indices. Do not reevaluate the freeform control net on the GPU.",
      "position": [
        930,
        0
      ]
    }
  ],
  "edges": [
    {
      "from": "inputs",
      "to": "cpu"
    },
    {
      "from": "cpu",
      "to": "cache"
    },
    {
      "from": "cache",
      "to": "draw"
    }
  ]
}
