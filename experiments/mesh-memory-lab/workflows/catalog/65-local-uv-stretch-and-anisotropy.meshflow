{
  "format": "mesh-memory-lab.workflow",
  "version": 1,
  "title": "65. Local UV stretch and anisotropy",
  "description": "Catalog workflow 65. 3D triangle → orthonormal tangent frame → surface-to-UV Jacobian → scaled singular-value calculation → minimum/maximum stretch → anisotropy. Inspect shear, uniform scaling, and nearly rank-one maps.\n\nDescriptive diagram: stages and values are explained in the inspector; this file does not execute the workflow or capture historical results.\n\nImplementation: src/uv_quality.cpp:analyzeUvQuality; tests/uv_quality_tests.cpp.",
  "initial_node": "jacobian",
  "nodes": [
    {
      "id": "triangle",
      "title": "Valid triangle map",
      "kind": "data",
      "summary": "3D points and supplied UVs",
      "description": "Exclude missing UVs, collapsed UV triangles, and degenerate surface triangles before differentiating the affine triangle map.",
      "position": [
        0,
        0
      ]
    },
    {
      "id": "frame",
      "title": "Orthonormal frame",
      "kind": "transform",
      "summary": "First edge defines tangent X",
      "description": "Let a=p1-p0, b=p2-p0, L=length(a), x=dot(a,b)/L, y=2*surfaceArea/L. The surface triangle becomes (0,0), (L,0), (x,y).",
      "position": [
        310,
        0
      ]
    },
    {
      "id": "jacobian",
      "title": "Surface-to-UV map",
      "kind": "transform",
      "summary": "Two-by-two Jacobian",
      "description": "For UV edges u and v: j00=u.x/L, j10=u.y/L, j01=(v.x-j00*x)/y, j11=(v.y-j10*x)/y. UV units are per physical surface unit.",
      "position": [
        620,
        0
      ]
    },
    {
      "id": "scale",
      "title": "Scale coefficients",
      "kind": "transform",
      "summary": "Largest absolute J entry",
      "description": "Divide J by its largest absolute entry before forming the symmetric J-transpose-J terms to reduce overflow and numerical loss.",
      "position": [
        930,
        0
      ]
    },
    {
      "id": "maximum",
      "title": "Largest singular value",
      "kind": "transform",
      "summary": "Scaled stable eigenvalue",
      "description": "For scaled columns, form e, f, g; sigmaMax=scale*sqrt((e+g+hypot(e-g,2*f))/2).",
      "position": [
        930,
        190
      ]
    },
    {
      "id": "minimum",
      "title": "Smallest singular value",
      "kind": "transform",
      "summary": "Area ratio / sigmaMax",
      "description": "Use sigmaMin=(uvArea/surfaceArea)/sigmaMax to avoid subtractive cancellation near a rank-one map.",
      "position": [
        620,
        190
      ]
    },
    {
      "id": "metrics",
      "title": "Stretch and anisotropy",
      "kind": "data",
      "summary": "sigmaMax / sigmaMin",
      "description": "Retain both singular values and their ratio. Uniform scaling changes stretch but not anisotropy; shear can produce anisotropy with unchanged area.",
      "position": [
        310,
        190
      ]
    },
    {
      "id": "normalization",
      "title": "Optional normalization",
      "kind": "transform",
      "summary": "Divide stretch by sqrt(baseline)",
      "description": "Apply the per-patch normalization from workflow 68. Measurements describe the supplied triangle mapping, not exact CAD derivatives.",
      "position": [
        0,
        190
      ]
    }
  ],
  "edges": [
    {
      "from": "triangle",
      "to": "frame"
    },
    {
      "from": "frame",
      "to": "jacobian"
    },
    {
      "from": "jacobian",
      "to": "scale"
    },
    {
      "from": "scale",
      "to": "maximum"
    },
    {
      "from": "maximum",
      "to": "minimum"
    },
    {
      "from": "minimum",
      "to": "metrics"
    },
    {
      "from": "metrics",
      "to": "normalization"
    }
  ]
}
