# woby scene
version = 5
master_vertex_point_size = 4
show_origin = true
show_grid = false
up_axis = "z"


[[files]]
path = "../../assets/samples/mesh-comparison/original.obj"
visible = true
scale = 1
opacity = 1
translation = [0, 0, 0]
rotation_degrees = [0, 0, 0]
vertex_size_scale = 1

[[files.groups]]
name = "surface"
visible = true
show_solid_mesh = true
show_triangles = false
show_vertices = true
scale = 1
opacity = 1
vertex_size_scale = 1
translation = [0, 0, 0]
rotation_degrees = [0, 0, 0]
color = [0.899999976, 0.219999999, 0.239999995, 1]

[[files]]
