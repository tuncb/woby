[[comparisons]]
name = "Comparison 1"
translation = [15, 0, 0]
comparison_enabled = true
comparison_mode = "distance"
comparison_distance_on_a = true
comparison_tolerance = 0.0500000007
comparison_color_range = 0.5
comparison_show_edges = false
comparison_show_boundaries = true
comparison_show_non_manifold = true

[[comparisons.a]]
file_index = 0
group_index = 0
name = "original.obj / surface"

[[comparisons.b]]
file_index = 1
group_index = 0
name = "repaired.obj / surface"
