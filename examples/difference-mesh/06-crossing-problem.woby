# woby scene
version = 24
coordinate_origin = [0, 0, 0]
master_vertex_point_size = 4
show_origin = false
show_grid = true
adaptive_points = true
triangle_edge_xray = false
show_dimensions = false
up_axis = "z"

[camera]
